# ---- Pick ONE free LLM provider ----
# groq   : https://console.groq.com/keys   (free, fast, supports tool calling)  <- recommended
# gemini : https://aistudio.google.com/apikey (free tier)
# ollama : local models, no key needed (ollama pull llama3.1)
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_MODEL=llama3.1

# ---- Demo switches (for showing self-correction live) ----
# Set to 1 to make the web search tool throw an error -> agent must fall back to local DB
SIMULATE_WEB_FAILURE=0
